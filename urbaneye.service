[Unit]
Description=UrbanEye Stream Recorder Service
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
# Ensure this User matches your Pi username (usually 'pi' or your custom user)
User=pi
WorkingDirectory=/home/pi/UrbanEye
ExecStart=/bin/bash /home/pi/UrbanEye/start_urbaneye.sh
Restart=on-failure
RestartSec=10
StandardOutput=inherit
StandardError=inherit

[Install]
WantedBy=multi-user.target

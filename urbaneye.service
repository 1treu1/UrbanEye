[Unit]
Description=UrbanEye Stream Recorder Service
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
# Updated user to match your prompt (treu)
User=treu
WorkingDirectory=/home/treu/UrbanEye
ExecStart=/bin/bash /home/treu/UrbanEye/start_urbaneye.sh
Restart=on-failure
RestartSec=10
StandardOutput=inherit
StandardError=inherit

[Install]
WantedBy=multi-user.target
